# Generated by blinded_init.py — the data-side image.
#
# Dependencies are baked in at BUILD time on purpose: at runtime this container
# sits on an internal-only network with no route to the internet, so nothing can
# be installed then (and nothing can be exfiltrated). If your project needs a
# private index or internal wheels, they must be reachable during `docker build`.
FROM python:{{PYTHON_VERSION}}-slim

WORKDIR /app

{{DEPS_INSTALL}}

# MCP server + the isolated pipeline runner. The project itself (including
# data/) is bind-mounted at runtime by docker-compose and made importable via
# PYTHONPATH below — it is deliberately NOT copied into the image.
COPY {{HARNESS_DIR}}/mcp_server/server.py /app/mcp_server/server.py
COPY {{HARNESS_DIR}}/mcp_server/pipeline_runner.py /app/mcp_server/pipeline_runner.py

ENV KEDRO_PROJECT_PATH=/app/project
ENV PYTHONPATH=/app/project/src
ENV PYTHONUNBUFFERED=1
# Play nicely with the read-only filesystem (see docker-compose.yml):
ENV PYTHONDONTWRITEBYTECODE=1
ENV DO_NOT_TRACK=1

EXPOSE 8000
CMD ["python", "/app/mcp_server/server.py"]
