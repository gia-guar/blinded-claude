# Generated by blinded_init.py — the two-container security boundary.
#
#   mcp_server : holds the DATA, but sits ONLY on the internal bridge network
#                (no internet -> nothing can be exfiltrated).
#   dev        : runs Claude Code. NO data mounted (source only). On the
#                internal bridge (to reach the MCP server) AND an external
#                network (to reach the Anthropic API).
#
# Data lives only in mcp_server; Claude only ever sees what the MCP tools return.
#
# Paths are relative to THIS file, which lives at <kedro-project>/{{HARNESS_DIR}}/,
# so `..` is the Kedro project root.

services:
  mcp_server:
    build:
      context: ..
      dockerfile: {{HARNESS_DIR}}/mcp_server/Dockerfile
    container_name: {{PROJECT_NAME}}_mcp_server
    # The kernel enforces the boundary: the whole filesystem is read-only and
    # data/ is the ONLY writable path. A node that tries to write anywhere else
    # (e.g. into src/) gets a PermissionError, no matter what the code does.
    read_only: true
    environment:
      KEDRO_PROJECT_PATH: /app/project
      PYTHONPATH: /app/project/src
      PYTHONDONTWRITEBYTECODE: "1"   # don't write .pyc next to read-only source
      DO_NOT_TRACK: "1"              # kedro-telemetry stays silent / writes nothing
      HOME: /tmp                     # throwaway writable home for stray config
    volumes:
      # The whole project read-only, with data/ remounted read-write on top.
      # Docker applies mounts shortest-path-first so the nested one wins, and
      # `read_only: true` above does not override an explicit volume's rw flag.
      - ..:/app/project:ro
      - ../data:/app/project/data          # <-- the ONLY rw path
    tmpfs:
      - /tmp                               # scratch space Python/kedro may need
    networks:
      - mcp_bridge
    expose:
      - "8000"

  dev:
    build:
      context: ..
      dockerfile: {{HARNESS_DIR}}/dev_container/Dockerfile
    container_name: {{PROJECT_NAME}}_claude_dev
    depends_on:
      - mcp_server
    working_dir: /workspace
    # OAuth (Claude subscription) auth — no API key. Two ways to fill this:
    #   1. Leave it empty and run `claude` once inside the container to log in
    #      interactively. The login is saved in the claude_config volume below,
    #      so you only do it once (survives rebuilds).
    #   2. Run `claude setup-token` on your host (browser works there), then set
    #      $env:CLAUDE_CODE_OAUTH_TOKEN before `docker compose up` to inject a
    #      long-lived token — no in-container login needed.
    environment:
      CLAUDE_CODE_OAUTH_TOKEN: ${CLAUDE_CODE_OAUTH_TOKEN:-}
    volumes:
      # ALLOWLIST — deny by default. Everything the agent may see is listed
      # explicitly below. Never add data/ or conf/local (credentials): the agent
      # runs pipelines through the MCP tools rather than locally, so it needs
      # neither, and adding one voids the entire security model.
{{DEV_MOUNTS}}
      - ./dev_container/claude_mcp_config.json:/workspace/.mcp.json:ro
      - ./CLAUDE.md:/workspace/CLAUDE.md:ro
      - claude_config:/root/.claude   # persist OAuth login + settings across rebuilds
    networks:
      - mcp_bridge   # reach the MCP server
      - external     # reach the Anthropic API
    command: sleep infinity

networks:
  # Internal: no route to the internet. The data-holding mcp_server is only
  # ever on this network.
  mcp_bridge:
    internal: true
  # Normal bridge with internet, used only by the (data-less) dev container.
  external:
    driver: bridge

volumes:
  # Persists Claude Code's OAuth login + settings so you don't re-auth on every
  # rebuild. Lives only in the dev container, which has no access to data/.
  claude_config:
